{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
<twig:ea:Modal:Trigger target="#cancel-modal" icon="fa fa-xmark" color="danger">Cancel</twig:ea:Modal:Trigger>

<twig:ea:Modal id="cancel-modal" title="Do you really want to cancel this deposit?">
    <twig:block name="body">
        <form id="cancel-form" action="{{ action.linkUrl }}" method="POST">
            <input type="hidden" name="_token" value="{{ csrf_token('cancel') }}">
        </form>
    </twig:block>
    <twig:block name="footer">
        <twig:ea:Modal:Close>No</twig:ea:Modal:Close>
        <twig:ea:Button color="danger" variant="solid" data-bs-dismiss="modal" form="cancel-form">Confirm</twig:ea:Button>
    </twig:block>
</twig:ea:Modal>
