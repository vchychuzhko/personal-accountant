{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
<twig:ea:Modal:Trigger target="#complete-modal" icon="fa fa-check" color="success">Complete</twig:ea:Modal:Trigger>

<twig:ea:Modal id="complete-modal" title="Do you want to complete this deposit?">
    <twig:block name="body">
        <form id="complete-form" action="{{ action.linkUrl }}" method="POST">
            <input type="hidden" name="_token" value="{{ csrf_token('complete') }}">
            <div class="field-number form-group">
                <label for="profit" class="form-control-label">Profit:</label>
                <div class="form-widget">
                    <input type="number" id="profit" name="profit" value="{{ ea().entity.instance.profit | number_format(2) }}"
                           inputmode="decimal" class="form-control" step="any"
                    >
                </div>
            </div>
        </form>
    </twig:block>
    <twig:block name="footer">
        <twig:ea:Modal:Close>Cancel</twig:ea:Modal:Close>
        <twig:ea:Button color="success" variant="solid" data-bs-dismiss="modal" form="complete-form">Complete</twig:ea:Button>
    </twig:block>
</twig:ea:Modal>
