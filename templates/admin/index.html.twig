{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block main %}
<div class="row row-gap-3">
    <div class="col-12 col-md-8">
        <twig:ea:Tabs class="justify-content-center">
            {% for index, chart in main_charts %}
                <twig:ea:Tabs:Item paneId="tab-{{ chart.id }}" label="{{ chart.title }}" active="{{ index == 0 }}" />
            {% endfor %}
        </twig:ea:Tabs>
        <div class="tab-content">
            {% for index, chart in main_charts %}
                <div class="tab-pane{% if index == 0 %} active{% endif %}" id="tab-{{ chart.id }}">
                    {{ render_chart(chart.chart) }}
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="col-12 col-md-4">
        <h2>Total: {{ total }}</h2>
        <hr>
        <h3>This month:</h3>
        <p>Incomes: {{ incomes_this_month }}</p>
        <p>Exchange difference: {{ exchange_difference_this_month }}</p>
        <p>Payments: {{ payments_this_month }}</p>
        <p>Difference: <strong>{{ difference_this_month }}</strong></p>
        <hr>
        <p class="text-secondary">Deposits: {{ total_in_deposits }}</p>
        <p class="text-secondary">Investments: {{ total_in_investments }}</p>
    </div>
</div>
<div class="row row-gap-3 mt-3">
    <div class="col-12 col-md-3">
        {{ render_chart(assets_by_balance_chart) }}
    </div>
    <div class="col-12 col-md-3">
        {{ render_chart(assets_by_currency_chart) }}
    </div>
    <div class="col-12 col-md-3">
        {{ render_chart(assets_by_type_chart) }}
    </div>
    <div class="col-12 col-md-3">
        {{ render_chart(expenses_by_tag_chart) }}
    </div>
</div>
{% endblock %}
